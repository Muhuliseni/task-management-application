{
  "name": "task-manager",
  "version": "1.0.0",
  "description": "A modern Task Management Application built with JavaScript ES6, demonstrating object-oriented programming, DOM manipulation, local storage, unit testing, and modern JavaScript features.",
  "type": "module",
  "main": "app.js",
  "scripts": {
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "coverage": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "keywords": [
    "javascript",
    "task-manager",
    "es6",
    "dom",
    "jest"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^29.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0"
  },
  "jest": {
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 85,
        "lines": 85,
        "statements": 85
      }
    }
  }
}